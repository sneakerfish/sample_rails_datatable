<div id="<%= dom_id contact %>">
  <div>
    <strong>First name:</strong>
    <%= contact.first_name %>
  </div>

  <div>
    <strong>Last name:</strong>
    <%= contact.last_name %>
  </div>

  <div>
    <strong>Email:</strong>
    <%= contact.email %>
  </div>

  <div>
    <strong>Phone:</strong>
    <%= contact.phone %>
  </div>

  <div>
    <strong>Company:</strong>
    <%= contact.company %>
  </div>

</div>
